# ITL Registration Service environment configuration
# Copy this to .env and fill in your values

# Public URL of the Registration Service (used in config_url responses)
ITL_SERVICE_URL=https://reg.itlusions.com

# GitHub Releases base URL for Talos ISOs and configs
# The CI publishes ISOs as: <RELEASE_URL>/itl-talos-<role>-amd64.iso
ITL_ISO_BASE_URL=https://github.com/ITlusions/ITL.Talos.HardenedOS/releases/latest/download

# Admin bearer token — REQUIRED, must be a strong random value
# Generate: openssl rand -hex 32
ITL_ADMIN_TOKEN=

# Talos GitHub Release tag to download role configs from (e.g. v1.0.3)
TALOS_RELEASE_TAG=latest
