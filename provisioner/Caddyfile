# Caddyfile — TLS reverse proxy for ITL Machine Registration Service
# Replace reg.itlusions.com with your actual domain.
# Caddy auto-provisions a Let's Encrypt cert for the domain.

reg.itlusions.com {
    reverse_proxy registration:8080 {
        health_uri   /healthz
        health_interval 30s
    }

    # ── Public endpoints (USB agent + Talos extension) ────────────────────
    # These are called without an admin token.
    @public path /api/v1/register /api/v1/attest /api/v1/config/* /healthz /docs /openapi.json
    handle @public {
        reverse_proxy registration:8080
    }

    # ── Certificate enrollment (offline-provisioned Talos nodes) ─────────
    # No admin token required — authenticated by the Enrollment CA cert
    # via challenge-response inside the Registration Service.
    # Rate-limit to 10 req/min per IP to deter brute-force attempts.
    @enroll path /api/v1/machines/enroll
    handle @enroll {
        rate_limit {
            zone enroll_zone {
                key    {remote_host}
                events 10
                window 1m
            }
        }
        reverse_proxy registration:8080
    }

    # ── Admin endpoints — restrict to internal network or VPN ────────────
    @admin path /api/v1/machines*
    handle @admin {
        reverse_proxy registration:8080
    }

    log {
        output stdout
        format json
    }
}
