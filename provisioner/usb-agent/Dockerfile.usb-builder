# Dockerfile.usb-builder
#
# Builds a bootable Alpine Linux USB ISO with the ITL TPM registration agent.
#
# Approach: download + remaster.
#   1. Download the official Alpine virt ISO (BIOS + UEFI hybrid, ~60 MB)
#   2. Build an apkovl overlay tarball containing register.sh + auto-start hook
#   3. Patch GRUB to add console=ttyS0 (serial output for QEMU testing)
#   4. Remaster with xorriso, preserving all El Torito / isohybrid boot records
#
# No loop devices, no mkimage.sh, no --privileged needed.
# Works in any standard docker build environment.
#
# Boot sequence on real hardware:
#   USB → GRUB → Alpine kernel+initramfs → live boot →
#   apkovl applied → 00-itl-register.start runs → register.sh →
#   TPM EK read → POST /register → download Talos ISO → dd → reboot
#
# Build args:
#   ALPINE_RELEASE   Full Alpine point release  (default: 3.21.3)
#   ITL_REG_URL      Registration Service URL   (default: https://reg.itlusions.com)
#   ITL_ROLE         Default node role           (default: worker-app)
#
# Output: /usb-agent.iso  (~60 MB)
# Write to USB: dd if=usb-agent.iso of=/dev/sdX bs=4M status=progress
# ─────────────────────────────────────────────────────────────────────────────
FROM alpine:3.21 AS builder

ARG ALPINE_RELEASE=3.21.3
ARG ITL_REG_URL=https://reg.itlusions.com
ARG ITL_ROLE=worker-app

RUN apk add --no-cache xorriso wget ca-certificates

# ── 1. Download official Alpine virt ISO ──────────────────────────────────────
RUN wget -q \
    "https://dl-cdn.alpinelinux.org/alpine/v3.21/releases/x86_64/alpine-virt-${ALPINE_RELEASE}-x86_64.iso" \
    -O /alpine-base.iso \
 && echo "Downloaded: alpine-virt-${ALPINE_RELEASE}-x86_64.iso ($(stat -c %s /alpine-base.iso) bytes)"

# ── 2. Build the apkovl overlay ───────────────────────────────────────────────
# Alpine live boot scans the boot media for *.apkovl.tar.gz files and applies
# them as filesystem overlays on top of the running system.  We inject:
#   /usr/local/itl/register.sh          the registration agent
#   /etc/itl-reg.conf                   baked defaults (reg URL + role)
#   /etc/local.d/00-itl-register.start  auto-start hook
#   /etc/runlevels/default/local        enables the 'local' OpenRC service
COPY register.sh /tmp/register.sh

RUN chmod +x /tmp/register.sh \
 && mkdir -p \
      /apkovl/usr/local/itl \
      /apkovl/etc/local.d \
      /apkovl/etc/runlevels/default \
 && cp /tmp/register.sh /apkovl/usr/local/itl/register.sh \
 && printf '#!/bin/sh\n'                                                    >  /apkovl/etc/local.d/00-itl-register.start \
 && printf '. /etc/itl-reg.conf 2>/dev/null || true\n'                     >> /apkovl/etc/local.d/00-itl-register.start \
 && printf 'exec /usr/local/itl/register.sh 2>&1 | tee /var/log/itl-register.log\n' >> /apkovl/etc/local.d/00-itl-register.start \
 && chmod +x /apkovl/etc/local.d/00-itl-register.start \
 && ln -sf /etc/init.d/local /apkovl/etc/runlevels/default/local \
 && printf '# ITL Registration Agent — baked defaults\n'                   >  /apkovl/etc/itl-reg.conf \
 && printf 'ITL_REG_URL="%s"\n' "${ITL_REG_URL}"                           >> /apkovl/etc/itl-reg.conf \
 && printf 'ITL_ROLE="%s"\n'    "${ITL_ROLE}"                              >> /apkovl/etc/itl-reg.conf \
 && cd /apkovl && tar -czf /itl.apkovl.tar.gz . \
 && echo "apkovl built: $(stat -c %s /itl.apkovl.tar.gz) bytes"

# ── 3. Patch GRUB: add console=ttyS0 to every kernel line ────────────────────
# Alpine 3.17+ uses GRUB for both BIOS and UEFI.
# Adding console=ttyS0 lets QEMU -nographic -serial capture kernel boot output.
# (Harmless on real hardware — serial port just has no listener.)
RUN xorriso -osirrox on -indev /alpine-base.iso \
      -extract /boot/grub/grub.cfg /grub.cfg 2>/dev/null \
 && sed -i '/^\s*linux /s/$/ console=ttyS0/' /grub.cfg \
 && echo "--- patched grub.cfg ---" && grep -E 'linux |menuentry' /grub.cfg

# ── 4. Remaster: replay boot records, inject apkovl + grub.cfg ───────────────
# -boot_image any replay   preserves all El Torito + isohybrid MBR/GPT records
# -map src dst             adds/replaces files in the output ISO
RUN mkdir -p /output \
 && xorriso \
      -indev  /alpine-base.iso \
      -outdev /output/usb-agent.iso \
      -boot_image any replay \
      -map /itl.apkovl.tar.gz  /itl.apkovl.tar.gz \
      -map /grub.cfg           /boot/grub/grub.cfg \
      -commit \
 && echo "usb-agent.iso ready: $(stat -c %s /output/usb-agent.iso) bytes"

# ── Export ────────────────────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=builder /output/usb-agent.iso /usb-agent.iso
