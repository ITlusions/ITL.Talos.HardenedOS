# ─────────────────────────────────────────────────────────────────────────────
# Build a bootable iPXE ISO that chainloads to the ITL netboot menu.
#
# The embedded script is baked in at compile time so the USB works with no
# local disk or PXE config file needed — just power on and it finds the menu.
#
# Build args:
#   NETBOOT_SERVER   HTTP(S) base URL of the netboot server
#                    e.g. http://192.168.1.10  or  https://netboot.itlusions.local
#                    Default: http://192.168.1.10
#
#   IPXE_REF         iPXE git ref to build from (tag or commit)
#                    Default: v1.21.1
#
# Output: /output/ipxe-usb.iso  (write with dd or Rufus in DD-image mode)
# ─────────────────────────────────────────────────────────────────────────────
FROM alpine:3.21 AS builder

ARG NETBOOT_SERVER=http://192.168.1.10
ARG IPXE_REF=v1.21.1

RUN apk add --no-cache \
        git make gcc musl-dev binutils xz-dev \
        mtools syslinux \
        ca-certificates \
        xorriso

WORKDIR /build

RUN git clone --depth 1 --branch "${IPXE_REF}" https://github.com/ipxe/ipxe.git .

# ── Embedded chainload script — baked into the binary ─────────────────────────
# NETBOOT_SERVER is substituted at build time.
# The script tries DHCP on all NICs, then chains to menu.ipxe.
# Falls back to an iPXE shell on failure so an operator can diagnose.
RUN printf '#!ipxe\n\n' > src/chainload.ipxe \
 && printf ':retry\n' >> src/chainload.ipxe \
 && printf 'dhcp || ( echo DHCP failed, retrying in 5s && sleep 5 && goto retry )\n' >> src/chainload.ipxe \
 && printf 'echo\n' >> src/chainload.ipxe \
 && printf 'echo ITLusions — loading netboot menu...\n' >> src/chainload.ipxe \
 && printf 'echo   %s/menu.ipxe\n' "${NETBOOT_SERVER}" >> src/chainload.ipxe \
 && printf 'echo\n' >> src/chainload.ipxe \
 && printf 'chain %s/menu.ipxe || goto failed\n' "${NETBOOT_SERVER}" >> src/chainload.ipxe \
 && printf '\n' >> src/chainload.ipxe \
 && printf ':failed\n' >> src/chainload.ipxe \
 && printf 'echo\n' >> src/chainload.ipxe \
 && printf 'echo Failed to load menu from %s\n' "${NETBOOT_SERVER}" >> src/chainload.ipxe \
 && printf 'echo Check network and netboot server, then type: chain %s/menu.ipxe\n' "${NETBOOT_SERVER}" >> src/chainload.ipxe \
 && printf 'shell\n' >> src/chainload.ipxe

# ── Build ipxe.iso (BIOS hybrid via isolinux) ─────────────────────────────────
# EMBED= bakes chainload.ipxe into the binary.
# On Alpine, isolinux lives under /usr/share/syslinux — tell the build system.
RUN make -C src -j"$(nproc)" \
        bin/ipxe.iso \
        EMBED=chainload.ipxe \
        ISOLINUX_DIR=/usr/share/syslinux

# ── Copy output ────────────────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=builder /build/src/bin/ipxe.iso /ipxe-usb.iso
