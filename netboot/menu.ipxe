#!ipxe

# ─────────────────────────────────────────────────────────────────────────────
# ITL.Talos.HardenedOS — iPXE Network Boot Menu
#
# Variables (set via DHCP user-class / next-server or override below):
#
#   netboot-server    HTTP base URL of this netboot server
#                     e.g. http://192.168.1.10  or  https://netboot.itlusions.local
#
#   reg-url           Registration Service base URL (for ZTP talos.config delivery)
#                     e.g. https://reg.itlusions.com
#
#   config-base-url   Fallback config base URL (generic profiles)
#                     defaults to ${netboot-server}/config
#
# Kernel/initramfs are served from:
#   ${netboot-server}/boot/<profile>/vmlinuz
#   ${netboot-server}/boot/<profile>/initramfs.xz
#
# Populate these with: ./netboot/build-netboot-assets.sh (uses imager kernel/initramfs).
# ─────────────────────────────────────────────────────────────────────────────

# ── Default values — override via DHCP or chainload ──────────────────────────
isset ${netboot-server}  || set netboot-server  http://192.168.1.10
isset ${reg-url}         || set reg-url         https://reg.itlusions.com
isset ${config-base-url} || set config-base-url ${netboot-server}/config

# ── Common kernel arguments ───────────────────────────────────────────────────
set talos-common  console=ttyS0,115200 console=tty0 talos.platform=metal ip=dhcp

# ── Boot menu ─────────────────────────────────────────────────────────────────
:menu
menu ITlusions — Talos HardenedOS  [v1.9.0]
item --gap    ── ControlPlane Stack — Zero-Touch Provisioning ──────────────
item cpstack-cp       [ZTP]  ControlPlane Node
item cpstack-infra    [ZTP]  Worker — Infrastructure
item cpstack-app      [ZTP]  Worker — Application
item --gap    ── Generic Hardened Profiles ──────────────────────────────────
item itl-standard     ITL Hardened Standard
item itl-gpu          ITL Hardened + NVIDIA GPU
item itl-storage      ITL Hardened + iSCSI Storage
item itl-proxmox      ITL Hardened + QEMU/Proxmox Agent
item --gap    ── Custom / Extra Extensions ──────────────────────────────────
item itl-custom       ITL Hardened + Custom Extensions  (edit menu.ipxe)
item --gap    ── Maintenance ─────────────────────────────────────────────────
item vanilla          Vanilla Talos v1.9.0 (upstream)
item shell            iPXE Shell
item reboot           Reboot
choose --timeout 60000 --default itl-standard target && goto ${target}

# ─────────────────────────────────────────────────────────────────────────────
# ControlPlane Stack — ZTP entries
# talos.config points to the Registration Service which delivers role-specific
# machineconfigs.  The kernel/initramfs are extracted from the role ISOs built
# by build-controlplane-stack-flavor.yaml.
# ─────────────────────────────────────────────────────────────────────────────

:cpstack-cp
echo Booting ITL ControlPlane Stack — ControlPlane Node
echo Config  : ${reg-url}/api/v1/config/controlplane
echo Kernel  : ${netboot-server}/boot/cpstack-controlplane/vmlinuz
echo
kernel ${netboot-server}/boot/cpstack-controlplane/vmlinuz \
  ${talos-common} \
  talos.config=${reg-url}/api/v1/config/controlplane \
  itl.flavor=controlplane-stack \
  itl.role=controlplane \
  itl.reg_url=${reg-url}
initrd ${netboot-server}/boot/cpstack-controlplane/initramfs.xz
boot || goto failed

:cpstack-infra
echo Booting ITL ControlPlane Stack — Worker Infra Node
echo Config  : ${reg-url}/api/v1/config/worker-infra
echo
kernel ${netboot-server}/boot/cpstack-worker-infra/vmlinuz \
  ${talos-common} \
  talos.config=${reg-url}/api/v1/config/worker-infra \
  itl.flavor=controlplane-stack \
  itl.role=worker-infra \
  itl.reg_url=${reg-url}
initrd ${netboot-server}/boot/cpstack-worker-infra/initramfs.xz
boot || goto failed

:cpstack-app
echo Booting ITL ControlPlane Stack — Worker App Node
echo Config  : ${reg-url}/api/v1/config/worker-app
echo
kernel ${netboot-server}/boot/cpstack-worker-app/vmlinuz \
  ${talos-common} \
  talos.config=${reg-url}/api/v1/config/worker-app \
  itl.flavor=controlplane-stack \
  itl.role=worker-app \
  itl.reg_url=${reg-url}
initrd ${netboot-server}/boot/cpstack-worker-app/initramfs.xz
boot || goto failed

# ─────────────────────────────────────────────────────────────────────────────
# Generic hardened profiles
# These use kernel/initramfs extracted from profile-specific ISOs.
# Build them locally with:
#   PROFILE=<name> EXTRA_EXTENSIONS="..." ./build-simple.sh
# Or source the profile env:
#   source netboot/profiles/gpu.env && ./build-simple.sh
# Then build: PROFILE=<name> ./netboot/build-netboot-assets.sh  (uses imager kernel/initramfs)
# ─────────────────────────────────────────────────────────────────────────────

:itl-standard
echo Booting ITL Hardened Standard...
kernel ${netboot-server}/boot/standard/vmlinuz \
  ${talos-common} \
  talos.config=${config-base-url}/standard.yaml
initrd ${netboot-server}/boot/standard/initramfs.xz
boot || goto failed

:itl-gpu
echo Booting ITL Hardened + NVIDIA GPU...
echo NOTE: GPU kernel/initramfs must be built separately.
echo       Source: netboot/profiles/gpu.env  then run build-simple.sh
echo
kernel ${netboot-server}/boot/gpu/vmlinuz \
  ${talos-common} \
  talos.config=${config-base-url}/gpu.yaml
initrd ${netboot-server}/boot/gpu/initramfs.xz
boot || goto failed

:itl-storage
echo Booting ITL Hardened + iSCSI Storage...
kernel ${netboot-server}/boot/storage/vmlinuz \
  ${talos-common} \
  talos.config=${config-base-url}/storage.yaml
initrd ${netboot-server}/boot/storage/initramfs.xz
boot || goto failed

:itl-proxmox
echo Booting ITL Hardened + QEMU/Proxmox Agent...
kernel ${netboot-server}/boot/proxmox/vmlinuz \
  ${talos-common} \
  talos.config=${config-base-url}/proxmox.yaml
initrd ${netboot-server}/boot/proxmox/initramfs.xz
boot || goto failed

:itl-custom
# Edit the kernel/initramfs path and talos.config URL to match your custom build.
# Build with: EXTRA_EXTENSIONS="ghcr.io/your-org/your-ext:tag" ./build-simple.sh
echo Booting ITL Hardened + Custom Extensions...
kernel ${netboot-server}/boot/custom/vmlinuz \
  ${talos-common} \
  talos.config=${config-base-url}/custom.yaml
initrd ${netboot-server}/boot/custom/initramfs.xz
boot || goto failed

# ─────────────────────────────────────────────────────────────────────────────
# Vanilla Talos — upstream (no ITL extensions)
# Uses factory.talos.dev for kernel/initramfs (Method 2 from 10-TPM-PROVISIONING.md)
# ─────────────────────────────────────────────────────────────────────────────

:vanilla
set schematic 376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba
echo Booting Vanilla Talos v1.9.0 (upstream)...
kernel https://factory.talos.dev/image/${schematic}/v1.9.0/kernel-amd64 \
  talos.platform=metal console=ttyS0,115200 console=tty0 ip=dhcp
initrd https://factory.talos.dev/image/${schematic}/v1.9.0/initramfs-amd64.xz
boot || goto failed

# ─────────────────────────────────────────────────────────────────────────────
# Maintenance
# ─────────────────────────────────────────────────────────────────────────────

:shell
echo Entering iPXE shell.  Type 'exit' to return to menu.
shell
goto menu

:reboot
echo Rebooting in 3 seconds...
sleep 3
reboot

:failed
echo
echo Boot failed.  Returning to menu in 10 seconds...
sleep 10
goto menu
