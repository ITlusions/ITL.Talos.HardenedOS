# gpu — adds NVIDIA kmod + container toolkit on top of ITL core
# Usage: source netboot/profiles/gpu.env && ./build-simple.sh
#
# IMPORTANT: NVIDIA_TAG must match your Talos version.
# Find the correct tag at: https://github.com/siderolabs/extensions/releases
# Pattern: <driver-version>-<talos-version>  e.g. 535.216.01-v1.9.0
PROFILE=gpu
NVIDIA_TAG="${NVIDIA_TAG:-535.216.01-v1.9.0}"
EXTRA_EXTENSIONS="ghcr.io/siderolabs/nonfree-kmod-nvidia:${NVIDIA_TAG} ghcr.io/siderolabs/nvidia-container-toolkit:${NVIDIA_TAG}"
