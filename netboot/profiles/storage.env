# storage — adds iSCSI tools + util-linux for stateful storage nodes
# Usage: source netboot/profiles/storage.env && ./build-simple.sh
#
# Find extension tags at: https://github.com/siderolabs/extensions/releases
PROFILE=storage
EXTRA_EXTENSIONS="ghcr.io/siderolabs/iscsi-tools:v0.1.4-v1.9.0 ghcr.io/siderolabs/util-linux-tools:2.40.1-v1.9.0"
